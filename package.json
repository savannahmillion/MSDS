{
  "name": "@msds/ui",
  "version": "0.12.0",
  "description": "Million Somethings Design System — tokens and primitives shared across personal projects.",
  "type": "module",
  "private": false,
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "icons": "node scripts/icons-build.js",
    "icons:add": "node scripts/icons-add-material.js"
  },
  "exports": {
    ".": "./tokens/tokens.js",
    "./tokens": "./tokens/tokens.js",
    "./tokens.css": "./tokens/tokens.css",
    "./styles": "./styles/index.css",
    "./styles/reset.css": "./styles/reset.css",
    "./styles/base.css": "./styles/base.css",
    "./tailwind.preset.js": "./tokens/tailwind.preset.js",
    "./icons": "./icons/index.js",
    "./icons.css": "./icons/icons.css",
    "./icons/*": "./icons/*"
  },
  "files": [
    "tokens",
    "styles",
    "icons",
    "components",
    "docs",
    "CLAUDE.md"
  ]
}
